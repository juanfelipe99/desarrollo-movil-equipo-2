<?xml version="1.0" encoding="utf-8"?>
<!-- Mensajes de error y de lista vacía. En vertical empiezan a 120 dp de arriba, como en el prototipo. -->
<resources>
    <!-- center_horizontal -->
    <integer name="state_message_gravity">1</integer>
    <dimen name="state_message_padding_top">120dp</dimen>
    <!-- 32 dp más los 81 dp de la barra inferior (dimens_nav.xml). Con la letra al 200 % el mensaje es más alto que
         la pantalla y, al desplazarlo hasta el final, «Reintentar» quedaba debajo de la barra -->
    <dimen name="state_message_padding_bottom">113dp</dimen>
    <dimen name="state_icon_circle_size">88dp</dimen>
    <dimen name="state_icon_margin_bottom">24dp</dimen>
    <dimen name="state_retry_margin_top">24dp</dimen>
    <dimen name="state_icon_size">40dp</dimen>

    <!-- Dentro de una lista, debajo de su encabezado, el prototipo dibuja el mensaje más arriba y con el círculo más chico -->
    <dimen name="state_compact_padding_top">56dp</dimen>
    <dimen name="state_compact_icon_circle_size">72dp</dimen>
    <dimen name="state_compact_icon_size">32dp</dimen>
</resources>
