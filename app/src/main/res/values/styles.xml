<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Widget.Vinilos.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/md_surface</item>
        <item name="contentInsetStart">20dp</item>
        <!-- Sin el margen de 4 dp de AppCompat, el título queda a 20 dp o justo después de la X. -->
        <item name="titleMarginStart">0dp</item>
        <item name="titleTextAppearance">@style/TextAppearance.Vinilos.TitleLarge</item>
        <item name="navigationIconTint">@color/md_on_surface</item>
    </style>

    <style name="Widget.Vinilos.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/md_surface_container</item>
        <item name="elevation">0dp</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="itemActiveIndicatorStyle">
            @style/Widget.Vinilos.BottomNavigation.ActiveIndicator
        </item>
        <item name="itemIconTint">@color/nav_item_icon</item>
        <item name="itemTextColor">@color/nav_item_text</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.Vinilos.LabelMedium.Bold</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.Vinilos.LabelMedium</item>
    </style>

    <style name="Widget.Vinilos.BottomNavigation.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/md_primary_container</item>
    </style>

    <!-- La misma barra como riel, para el teléfono en horizontal. -->
    <style name="Widget.Vinilos.NavigationRail" parent="Widget.Material3.NavigationRailView">
        <item name="android:background">@color/md_surface_container</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="itemActiveIndicatorStyle">
            @style/Widget.Vinilos.NavigationRail.ActiveIndicator
        </item>
        <item name="itemIconTint">@color/nav_item_icon</item>
        <item name="itemTextColor">@color/nav_item_text</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.Vinilos.LabelMedium.Bold</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.Vinilos.LabelMedium</item>
    </style>

    <style name="Widget.Vinilos.NavigationRail.ActiveIndicator" parent="Widget.Material3.NavigationRailView.ActiveIndicator">
        <item name="android:color">@color/md_primary_container</item>
    </style>

    <style name="Widget.Vinilos.Divider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/md_outline_variant</item>
    </style>

    <style name="Widget.Vinilos.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">24dp</item>
    </style>

    <style name="Widget.Vinilos.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">24dp</item>
    </style>

    <!-- Etiqueta siempre arriba y texto de ejemplo siempre visible, como en el prototipo. -->
    <style name="Widget.Vinilos.FormField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="expandedHintEnabled">false</item>
        <item name="boxCornerRadiusTopStart">4dp</item>
        <item name="boxCornerRadiusTopEnd">4dp</item>
        <item name="boxCornerRadiusBottomStart">4dp</item>
        <item name="boxCornerRadiusBottomEnd">4dp</item>
        <item name="errorIconDrawable">@null</item>
        <item name="errorTextAppearance">@style/TextAppearance.Vinilos.Supporting</item>
        <item name="helperTextTextAppearance">@style/TextAppearance.Vinilos.Supporting</item>
    </style>

    <style name="Widget.Vinilos.FormField.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="expandedHintEnabled">false</item>
        <item name="boxCornerRadiusTopStart">4dp</item>
        <item name="boxCornerRadiusTopEnd">4dp</item>
        <item name="boxCornerRadiusBottomStart">4dp</item>
        <item name="boxCornerRadiusBottomEnd">4dp</item>
        <item name="endIconDrawable">@drawable/ic_expand_more</item>
        <item name="errorIconDrawable">@null</item>
        <item name="errorTextAppearance">@style/TextAppearance.Vinilos.Supporting</item>
        <item name="helperTextTextAppearance">@style/TextAppearance.Vinilos.Supporting</item>
    </style>

    <!-- 15 dp arriba y abajo para que el campo mida 52 dp, como en el prototipo. -->
    <style name="Widget.Vinilos.FormField.Input" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">15dp</item>
        <item name="android:paddingBottom">15dp</item>
    </style>

    <style name="Widget.Vinilos.FormField.DropdownInput" parent="Widget.Material3.AutoCompleteTextView.OutlinedBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">15dp</item>
        <item name="android:paddingBottom">15dp</item>
        <item name="simpleItemSelectedColor">@color/md_primary_container</item>
    </style>

    <!-- Filtro de una sola opción: el elegido lleva fondo y ✓, los demás solo borde. -->
    <style name="Widget.Vinilos.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="android:textAppearance">@style/TextAppearance.Vinilos.LabelLarge</item>
        <item name="checkedIcon">@drawable/ic_check</item>
        <item name="checkedIconTint">@color/md_on_secondary_container</item>
    </style>

    <style name="ShapeAppearance.Vinilos.Cover" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="ShapeAppearance.Vinilos.AlbumCover" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.Vinilos.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="Widget.Vinilos.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/md_surface_container_lowest</item>
        <item name="strokeColor">@color/md_outline_variant</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="Widget.Vinilos.Snackbar" parent="Widget.Material3.Snackbar">
        <item name="android:layout_margin">16dp</item>
    </style>

    <style name="Widget.Vinilos.Skeleton.Block" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">120dp</item>
        <item name="android:background">@drawable/bg_skeleton_block</item>
    </style>

    <style name="Widget.Vinilos.Skeleton.Line" parent="">
        <item name="android:layout_height">14dp</item>
        <item name="android:background">@drawable/bg_skeleton_line</item>
    </style>

    <style name="Widget.Vinilos.Skeleton.Line.Secondary">
        <item name="android:layout_height">12dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:background">@drawable/bg_skeleton_line_secondary</item>
    </style>

    <style name="Widget.Vinilos.Skeleton.Circle" parent="">
        <item name="android:background">@drawable/bg_skeleton_circle</item>
    </style>

    <style name="TextAppearance.Vinilos.DisplaySmall" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">@font/roboto_bold</item>
        <item name="fontFamily">@font/roboto_bold</item>
        <item name="android:textSize">40sp</item>
        <item name="lineHeight">48sp</item>
        <item name="android:lineHeight" tools:targetApi="28">48sp</item>
        <item name="android:textColor">@color/md_on_surface</item>
    </style>

    <style name="TextAppearance.Vinilos.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/roboto_semibold</item>
        <item name="fontFamily">@font/roboto_semibold</item>
        <item name="android:textSize">28sp</item>
        <item name="lineHeight">36sp</item>
        <item name="android:lineHeight" tools:targetApi="28">36sp</item>
        <item name="android:textColor">@color/md_on_surface</item>
    </style>

    <style name="TextAppearance.Vinilos.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">@font/roboto_semibold</item>
        <item name="fontFamily">@font/roboto_semibold</item>
        <item name="android:textSize">22sp</item>
        <item name="lineHeight">28sp</item>
        <item name="android:lineHeight" tools:targetApi="28">28sp</item>
        <item name="android:textColor">@color/md_on_surface</item>
    </style>

    <style name="TextAppearance.Vinilos.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/roboto_medium</item>
        <item name="fontFamily">@font/roboto_medium</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/md_on_surface</item>
    </style>

    <style name="TextAppearance.Vinilos.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/roboto_semibold</item>
        <item name="fontFamily">@font/roboto_semibold</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="TextAppearance.Vinilos.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:fontFamily">@font/roboto_medium</item>
        <item name="fontFamily">@font/roboto_medium</item>
    </style>

    <style name="TextAppearance.Vinilos.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/roboto_regular</item>
        <item name="fontFamily">@font/roboto_regular</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.Vinilos.BodyLarge.SemiBold">
        <item name="android:fontFamily">@font/roboto_semibold</item>
        <item name="fontFamily">@font/roboto_semibold</item>
        <item name="lineHeight">22sp</item>
        <item name="android:lineHeight" tools:targetApi="28">22sp</item>
    </style>

    <style name="TextAppearance.Vinilos.BodyLarge.Bold">
        <item name="android:fontFamily">@font/roboto_bold</item>
        <item name="fontFamily">@font/roboto_bold</item>
    </style>

    <style name="TextAppearance.Vinilos.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/roboto_regular</item>
        <item name="fontFamily">@font/roboto_regular</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextAppearance.Vinilos.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/roboto_regular</item>
        <item name="fontFamily">@font/roboto_regular</item>
    </style>

    <!-- Ayuda y errores debajo de los campos. -->
    <style name="TextAppearance.Vinilos.Supporting" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/roboto_regular</item>
        <item name="fontFamily">@font/roboto_regular</item>
        <item name="android:textSize">13sp</item>
        <item name="lineHeight">18sp</item>
        <item name="android:lineHeight" tools:targetApi="28">18sp</item>
    </style>

    <style name="TextAppearance.Vinilos.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/roboto_semibold</item>
        <item name="fontFamily">@font/roboto_semibold</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextAppearance.Vinilos.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">@font/roboto_medium</item>
        <item name="fontFamily">@font/roboto_medium</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="TextAppearance.Vinilos.LabelMedium.SemiBold">
        <item name="android:fontFamily">@font/roboto_semibold</item>
        <item name="fontFamily">@font/roboto_semibold</item>
    </style>

    <style name="TextAppearance.Vinilos.LabelMedium.Bold">
        <item name="android:fontFamily">@font/roboto_bold</item>
        <item name="fontFamily">@font/roboto_bold</item>
    </style>

    <style name="TextAppearance.Vinilos.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/roboto_semibold</item>
        <item name="fontFamily">@font/roboto_semibold</item>
        <item name="android:textSize">13sp</item>
        <item name="lineHeight">18sp</item>
        <item name="android:lineHeight" tools:targetApi="28">18sp</item>
    </style>
</resources>
