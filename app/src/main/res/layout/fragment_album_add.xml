<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Texto de arriba: se ve con álbumes y en el vacío, no al cargar ni en el error -->
            <LinearLayout
                android:id="@+id/albumAddHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="12dp"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/albumAddSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Vinilos.BodyMedium"
                    android:textColor="@color/md_on_surface_variant"
                    tools:text="Elige el álbum que quieres agregar a Rubén Blades Bellido de Luna." />

                <!-- Solo cuando el artista es una banda -->
                <TextView
                    android:id="@+id/albumAddBandNotice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_notice"
                    android:drawablePadding="12dp"
                    android:padding="16dp"
                    android:text="@string/album_add_band_notice"
                    android:textAppearance="@style/TextAppearance.Vinilos.BodyMedium"
                    android:textColor="@color/md_on_primary_container"
                    android:visibility="gone"
                    app:drawableStartCompat="@drawable/ic_info"
                    app:drawableTint="@color/md_on_primary_container"
                    tools:visibility="visible" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/albumSearchField"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/album_add_search_hint"
                    app:boxBackgroundColor="@color/md_surface_container"
                    app:boxCornerRadiusBottomEnd="28dp"
                    app:boxCornerRadiusBottomStart="28dp"
                    app:boxCornerRadiusTopEnd="28dp"
                    app:boxCornerRadiusTopStart="28dp"
                    app:boxStrokeWidth="0dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:endIconContentDescription="@string/cd_album_add_search_clear"
                    app:endIconMode="clear_text"
                    app:hintEnabled="false"
                    app:startIconDrawable="@drawable/ic_search"
                    app:startIconTint="@color/md_on_surface_variant">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/albumSearchInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/album_add_search_hint"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.Vinilos.BodyLarge" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- «13 álbumes en el catálogo» sin búsqueda, y «1 resultado» al buscar. TalkBack lo lee al cambiar -->
                <TextView
                    android:id="@+id/albumAddCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="24dp"
                    android:accessibilityLiveRegion="polite"
                    android:textAppearance="@style/TextAppearance.Vinilos.BodyMedium"
                    android:textColor="@color/md_on_surface_variant"
                    tools:text="13 álbumes en el catálogo" />
            </LinearLayout>

            <!-- Como en el prototipo, una línea de borde a borde separa el encabezado de la lista. Se ve solo con la lista -->
            <View
                android:id="@+id/albumAddListDivider"
                style="@style/Widget.Vinilos.Divider"
                android:visibility="gone"
                tools:visibility="visible" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/albumAddList"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingBottom="8dp"
                    android:visibility="gone"
                    tools:itemCount="5"
                    tools:listitem="@layout/item_album_candidate"
                    tools:visibility="visible" />

                <include
                    android:id="@+id/albumAddMessage"
                    layout="@layout/view_state_message"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <include
            android:id="@+id/albumAddLoading"
            layout="@layout/view_loading"
            android:visibility="gone" />

        <!-- Encima del listado para no moverlo al aparecer -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/albumAddSubmittingProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="@color/md_primary"
            app:trackColor="@color/md_primary_container"
            app:trackThickness="4dp" />
    </FrameLayout>

    <!-- Botones y el aviso «Elige un álbum»: se ven con álbumes y en el vacío -->
    <LinearLayout
        android:id="@+id/albumAddFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/albumRequiredError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="assertive"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:text="@string/error_album_required"
            android:textAppearance="@style/TextAppearance.Vinilos.Supporting"
            android:textColor="@color/md_error"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/ic_error"
            app:drawableTint="@color/md_error"
            tools:visibility="visible" />

        <View style="@style/Widget.Vinilos.Divider" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Sin alinear por el texto: al mostrar «Agregando…» con el círculo, el botón bajaba y quedaba cortado -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_max="528dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/albumAddCancelButton"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:text="@string/action_cancel" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/albumAddButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/action_add"
                    android:textColor="@color/button_save_text"
                    app:backgroundTint="@color/button_save_background"
                    app:iconGravity="textStart"
                    app:iconTint="@color/md_on_surface_variant" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</LinearLayout>
