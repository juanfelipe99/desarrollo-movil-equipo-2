<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Filtros y contador: se ven con artistas y en el vacío, no al cargar ni en el error -->
        <LinearLayout
            android:id="@+id/artistHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:visibility="gone"
            tools:visibility="visible">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/artistFilters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="8dp"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/filterAll"
                    style="@style/Widget.Vinilos.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/artist_filter_all" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/filterMusicians"
                    style="@style/Widget.Vinilos.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/artist_filter_musicians" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/filterBands"
                    style="@style/Widget.Vinilos.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/artist_filter_bands" />
            </com.google.android.material.chip.ChipGroup>

            <TextView
                android:id="@+id/artistCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:paddingBottom="4dp"
                android:textAppearance="@style/TextAppearance.Vinilos.BodyMedium"
                android:textColor="@color/md_on_surface_variant"
                tools:text="7 artistas" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/artistList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="@dimen/artist_list_padding_bottom"
                android:visibility="gone"
                tools:itemCount="7"
                tools:listitem="@layout/item_artist"
                tools:visibility="visible" />

            <include
                android:id="@+id/artistsMessage"
                layout="@layout/view_state_message"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <include
        android:id="@+id/artistsLoading"
        layout="@layout/view_loading"
        android:visibility="gone" />
</FrameLayout>
