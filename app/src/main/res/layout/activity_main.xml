<?xml version="1.0" encoding="utf-8"?>
<!-- Al bajar por el contenido las dos barras se esconden y al subir vuelven, ver MainActivity. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/md_surface"
        android:stateListAnimator="@null"
        app:liftOnScroll="false">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="64dp">

            <!-- La pantalla decide si hay chip y el chip decide si ya tiene un rol para mostrar. -->
            <FrameLayout
                android:id="@+id/roleChipSlot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginEnd="8dp">

                <include
                    android:id="@+id/roleChip"
                    layout="@layout/view_role_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_target" />
            </FrameLayout>
        </com.google.android.material.appbar.MaterialToolbar>

        <View
            android:id="@+id/toolbarDivider"
            style="@style/Widget.Vinilos.Divider" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Llega hasta abajo, detrás de la barra inferior, y cada lista deja @dimen/nav_bar_space al final. -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/navHost"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:defaultNavHost="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        app:navGraph="@navigation/nav_graph" />

    <!-- En horizontal es un riel a la izquierda, ver layout-land -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        app:layout_behavior="com.google.android.material.behavior.HideBottomViewOnScrollBehavior">

        <View
            android:id="@+id/navDivider"
            style="@style/Widget.Vinilos.Divider" />

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/navBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:menu="@menu/bottom_nav"
            tools:viewBindingType="com.google.android.material.navigation.NavigationBarView" />
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
