<?xml version="1.0" encoding="utf-8"?>
<!-- Premio de un artista: nombre, organización que lo otorga y fecha -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:padding="16dp">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_primary_container">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/ic_trophy"
                app:tint="@color/md_on_primary_container" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/prizeName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Vinilos.BodyLarge.SemiBold"
                android:textColor="@color/md_on_surface"
                tools:text="Grammy Award" />

            <TextView
                android:id="@+id/prizeOrganization"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.Vinilos.BodyMedium"
                android:textColor="@color/md_on_surface_variant"
                tools:text="National Academy of Recording Arts &amp; Sciences" />

            <TextView
                android:id="@+id/prizeDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.Vinilos.BodyMedium"
                android:textColor="@color/md_on_surface_variant"
                tools:text="10 de diciembre de 1978" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
