<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="@integer/state_message_gravity"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingTop="@dimen/state_message_padding_top"
        android:paddingEnd="32dp"
        android:paddingBottom="@dimen/state_message_padding_bottom">

        <FrameLayout
            android:id="@+id/stateIconCircle"
            android:layout_width="@dimen/state_icon_circle_size"
            android:layout_height="@dimen/state_icon_circle_size"
            android:layout_marginBottom="@dimen/state_icon_margin_bottom"
            android:background="@drawable/bg_circle_surface_container">

            <ImageView
                android:id="@+id/stateIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                app:tint="@color/md_on_surface_variant"
                tools:src="@drawable/ic_cloud_off" />
        </FrameLayout>

        <TextView
            android:id="@+id/stateTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Vinilos.HeadlineSmall"
            tools:text="No pudimos cargar los datos" />

        <TextView
            android:id="@+id/stateBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Vinilos.BodyLarge"
            android:textColor="@color/md_on_surface_variant"
            tools:text="Revisa tu conexión a internet e inténtalo de nuevo." />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/stateRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/state_retry_margin_top"
            android:text="@string/error_network_retry"
            android:visibility="gone"
            app:icon="@drawable/ic_refresh"
            app:iconSize="20dp"
            tools:visibility="visible" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
