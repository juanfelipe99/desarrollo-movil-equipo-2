<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Total de coleccionistas encima de la lista -->
    <LinearLayout
        android:id="@+id/collectorHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/collectorCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:paddingBottom="4dp"
            android:textAppearance="@style/TextAppearance.Vinilos.BodyMedium"
            android:textColor="@color/md_on_surface_variant"
            tools:text="4 coleccionistas" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/collectorList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/collector_list_padding_bottom"
            android:visibility="gone"
            tools:itemCount="4"
            tools:listitem="@layout/item_collector"
            tools:visibility="visible" />
    </FrameLayout>
</LinearLayout>
