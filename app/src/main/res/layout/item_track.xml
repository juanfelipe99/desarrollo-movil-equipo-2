<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <View style="@style/Widget.Vinilos.Divider" />

    <!-- El track recién agregado lleva fondo de fila nueva y «Nuevo» junto al nombre (HU08) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/trackRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/trackNumber"
            android:layout_width="24dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textAppearance="@style/TextAppearance.Vinilos.BodyMedium"
            android:textColor="@color/md_on_surface_variant"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="1" />

        <TextView
            android:id="@+id/trackName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:textAppearance="@style/TextAppearance.Vinilos.BodyLarge"
            android:textColor="@color/md_on_surface"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/trackNewBadge"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@id/trackNumber"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Decisiones" />

        <TextView
            android:id="@+id/trackNewBadge"
            style="@style/Widget.Vinilos.BadgeNew"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/trackDuration"
            app:layout_constraintStart_toEndOf="@id/trackName"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/trackDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:fontFeatureSettings="tnum"
            android:textAppearance="@style/TextAppearance.Vinilos.BodyMedium"
            android:textColor="@color/md_on_surface_variant"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="5:05" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
