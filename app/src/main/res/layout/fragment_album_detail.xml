<?xml version="1.0" encoding="utf-8"?>
<!-- Deslizar hacia abajo recarga el álbum -->
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/albumRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/albumScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/albumContent"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="@dimen/album_detail_padding_bottom"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintWidth_max="528dp">

                    <!-- El marcador queda detrás y se ve mientras la portada carga o si falla -->
                    <FrameLayout
                        android:layout_width="228dp"
                        android:layout_height="228dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_album_cover">

                        <ImageView
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            app:srcCompat="@drawable/ic_album"
                            app:tint="@color/placeholder_icon" />

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/albumCover"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/album_cover_description"
                            android:scaleType="centerCrop"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.Vinilos.AlbumCover" />
                    </FrameLayout>

                    <!-- Cabecera -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingTop="20dp">

                        <TextView
                            android:id="@+id/albumName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Vinilos.HeadlineMedium" />

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/albumPerformers"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            app:chipSpacingHorizontal="8dp"
                            app:chipSpacingVertical="8dp" />

                        <TextView
                            android:id="@+id/albumNoPerformers"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/album_detail_no_performers"
                            android:textAppearance="@style/TextAppearance.Vinilos.BodyMedium"
                            android:textColor="@color/md_on_surface_variant"
                            android:visibility="gone" />

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <include
                                    android:id="@+id/albumReleaseDate"
                                    layout="@layout/item_album_info" />

                                <View style="@style/Widget.Vinilos.Divider" />

                                <include
                                    android:id="@+id/albumGenre"
                                    layout="@layout/item_album_info" />

                                <View style="@style/Widget.Vinilos.Divider" />

                                <include
                                    android:id="@+id/albumRecordLabel"
                                    layout="@layout/item_album_info" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <!-- Descripción -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingTop="24dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/album_detail_description_title"
                            android:textAppearance="@style/TextAppearance.Vinilos.TitleMedium"
                            android:textColor="@color/md_on_surface" />

                        <TextView
                            android:id="@+id/albumDescription"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textAppearance="@style/TextAppearance.Vinilos.BodyLarge"
                            android:textColor="@color/md_on_surface" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/albumDescriptionToggle"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="0dp"
                            android:minHeight="48dp"
                            android:paddingHorizontal="4dp"
                            android:text="@string/album_detail_expand"
                            android:textAppearance="@style/TextAppearance.Vinilos.LabelLarge"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- Tracks -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:baselineAligned="true"
                        android:gravity="center_vertical"
                        android:minHeight="48dp"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/album_detail_tracks_title"
                            android:textAppearance="@style/TextAppearance.Vinilos.TitleMedium"
                            android:textColor="@color/md_on_surface" />

                        <TextView
                            android:id="@+id/tracksCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:textAppearance="@style/TextAppearance.Vinilos.BodyMedium"
                            android:textColor="@color/md_on_surface_variant" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/tracksList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <View
                        android:id="@+id/tracksListEnd"
                        style="@style/Widget.Vinilos.Divider" />

                    <FrameLayout
                        android:id="@+id/tracksEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="16dp" />

                    <!-- Comentarios -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingTop="24dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/album_detail_comments_title"
                                android:textAppearance="@style/TextAppearance.Vinilos.TitleMedium"
                                android:textColor="@color/md_on_surface" />

                            <TextView
                                android:id="@+id/commentsCount"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textAppearance="@style/TextAppearance.Vinilos.BodyMedium"
                                android:textColor="@color/md_on_surface_variant" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/commentsList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>

        <include
            android:id="@+id/albumLoading"
            layout="@layout/view_loading"
            android:visibility="gone" />

        <include
            android:id="@+id/albumError"
            layout="@layout/view_state_message"
            android:visibility="gone" />
    </FrameLayout>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
