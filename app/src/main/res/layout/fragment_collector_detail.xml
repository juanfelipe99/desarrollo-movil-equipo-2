<?xml version="1.0" encoding="utf-8"?>
<!-- Detalle de coleccionista (HU06). Deslizar hacia abajo recarga el coleccionista -->
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/collectorRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/collectorScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/collectorContent"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="@dimen/album_detail_padding_bottom"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintWidth_max="528dp"
                    tools:visibility="visible">

                    <!-- Cabecera: iniciales, nombre y cuántos álbumes tiene -->
                    <TextView
                        android:id="@+id/collectorInitials"
                        android:layout_width="@dimen/artist_photo"
                        android:layout_height="@dimen/artist_photo"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/bg_circle_primary_container"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:textAppearance="@style/TextAppearance.Vinilos.HeadlineMedium"
                        android:textColor="@color/md_on_primary_container"
                        tools:text="JM" />

                    <TextView
                        android:id="@+id/collectorName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_horizontal"
                        android:paddingHorizontal="16dp"
                        android:textAppearance="@style/TextAppearance.Vinilos.HeadlineMedium"
                        tools:text="Jaime Monsalve" />

                    <TextView
                        android:id="@+id/collectorSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_horizontal"
                        android:paddingHorizontal="16dp"
                        android:textAppearance="@style/TextAppearance.Vinilos.BodyMedium"
                        android:textColor="@color/md_on_surface_variant"
                        tools:text="Coleccionista · 2 álbumes" />

                    <!-- Contacto -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginTop="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <include
                                android:id="@+id/collectorPhone"
                                layout="@layout/item_album_info" />

                            <View style="@style/Widget.Vinilos.Divider" />

                            <include
                                android:id="@+id/collectorEmail"
                                layout="@layout/item_album_info" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Artistas favoritos -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:gravity="center_vertical"
                        android:minHeight="48dp"
                        android:paddingHorizontal="16dp"
                        android:text="@string/collector_detail_favorites_title"
                        android:textAppearance="@style/TextAppearance.Vinilos.TitleMedium"
                        android:textColor="@color/md_on_surface" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/favoritesList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:orientation="horizontal"
                        android:paddingHorizontal="8dp"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:itemCount="3"
                        tools:listitem="@layout/item_favorite_artist" />

                    <FrameLayout
                        android:id="@+id/favoritesEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="16dp" />

                    <!-- Colección de álbumes -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:gravity="center_vertical"
                        android:minHeight="48dp"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/collector_detail_albums_title"
                            android:textAppearance="@style/TextAppearance.Vinilos.TitleMedium"
                            android:textColor="@color/md_on_surface" />

                        <TextView
                            android:id="@+id/collectorAlbumsCount"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textAppearance="@style/TextAppearance.Vinilos.BodyMedium"
                            android:textColor="@color/md_on_surface_variant"
                            tools:text="· 2 álbumes" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/collectorAlbumsList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:itemCount="2"
                        tools:listitem="@layout/item_collector_album" />

                    <FrameLayout
                        android:id="@+id/collectorAlbumsEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="16dp" />

                    <!-- Comentarios -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:gravity="center_vertical"
                        android:minHeight="48dp"
                        android:paddingHorizontal="16dp"
                        android:text="@string/collector_detail_comments_title"
                        android:textAppearance="@style/TextAppearance.Vinilos.TitleMedium"
                        android:textColor="@color/md_on_surface" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/commentsList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:paddingHorizontal="16dp"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:itemCount="1"
                        tools:listitem="@layout/item_collector_comment" />

                    <FrameLayout
                        android:id="@+id/commentsEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="16dp" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>

        <include
            android:id="@+id/collectorLoading"
            layout="@layout/view_loading"
            android:visibility="gone" />

        <include
            android:id="@+id/collectorError"
            layout="@layout/view_state_message"
            android:visibility="gone" />
    </FrameLayout>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
